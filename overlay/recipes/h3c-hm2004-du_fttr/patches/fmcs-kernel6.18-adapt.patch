@@ -625,6 +626,12 @@
 	return ret;
 }
 
+/* no_llseek() 已被 v6.x 内核删除；这里保留它原本返回 -ESPIPE 的语义。 */
+static loff_t fmcs_no_llseek(struct file *file, loff_t offset, int whence)
+{
+	return -ESPIPE;
+}
+
 static const struct file_operations fmcs_mci_fops = {
 	.owner		= THIS_MODULE,
 	.open		= fmcs_mci_open,
@@ -633,7 +640,7 @@
