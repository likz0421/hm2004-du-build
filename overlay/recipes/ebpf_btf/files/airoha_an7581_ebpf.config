# 由 ebpf_btf recipe 追加到源码树的 target/linux/airoha/an7581/config-6.18 末尾。
# 只放「OpenWrt 没有 CONFIG_KERNEL_* 对应项」的裸内核符号——这些没法通过 .config
# 选，只能进子 target 的内核配置文件（子 target 文件比 generic 文件优先）。
# 其余 BTF/CO-RE 符号走 deconfig/fragments/ebpf_btf.config，两条路都由
# scripts/assert_prebuild.sh 校验最终结果。
#
# 上游现状（pbs05/ponwrt@03c13454，已核对）：
#   target/linux/generic/config-6.18:769  CONFIG_BPF=y
#   target/linux/generic/config-6.18:770  CONFIG_BPF_JIT=y
#   target/linux/generic/config-6.18:777  CONFIG_BPF_SYSCALL=y
#   target/linux/generic/config-6.18:4411 # CONFIG_NET_ACT_BPF is not set
#   target/linux/generic/config-6.18:4432 # CONFIG_NET_CLS_BPF is not set
# 后两个是 not set，而 package/kernel/linux/modules/netsupport.mk:825 的
# KernelPackage/sched-bpf 恰好要这两个符号出 cls_bpf.ko / act_bpf.ko。
# honk 的数据面靠 TC 挂 eBPF，缺这两个模块就是起不来，所以在这里显式补 =m，
# 并在构建后断言 kmod-sched-bpf 的包真的产出（见 assert_artifacts.sh）。

# --- eBPF 基础（generic 里已是 y，这里重复一次写明意图）---
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# --- honk 需要的 TC / sockmap 支撑 ---
CONFIG_NET_SOCKMAP=y
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m
