# honk（eBPF 透明代理）运行期依赖片段。
# 作为 wrt_core/deconfig/fragments/honk.config 覆盖进引擎。
#
# 包名与依赖出处（已核对 kenzok8/openwrt-honk@67745c3a 的 honk/Makefile:66）：
#   DEPENDS:=@(x86_64||aarch64||arm) +ca-bundle +ip-full +ubus
#            +kmod-sched-core +kmod-sched-bpf +kmod-veth +kmod-nft-queue
#            +jsonfilter +jshn +sqlite3-cli +usign +coreutils-stat
#            +v2ray-geoip +v2ray-geosite
# 这里只显式写四个 kmod（它们是真正吃内核配置的，见 ebpf_btf 片段的说明），
# 其余纯用户态依赖由 DEPENDS 自动带入，不在这里重复，避免上游改依赖时两头维护。

CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y

# honk 数据面：TC 挂钩（cls_bpf/act_bpf）+ veth + nft 队列
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-queue=y

# 该 feed 只发 OpenWrt/ImmortalWrt 25.12（apk 包）且要求内核 6.12+。
# HM2004-DU 这边两点都满足：ponwrt 是 25.12 基线（CONFIG_USE_APK=y），
# 内核 6.18.55（target/linux/generic/kernel-6.18）。断言见 assert_artifacts.sh。
